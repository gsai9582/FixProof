# FixProof Backend Environment Configuration
PROJECT_NAME="FixProof"
PROJECT_TAGLINE="Don't just report it. Prove it's fixed."

# Database: SQLite locally, Supabase Postgres in production
DATABASE_URL="sqlite:///./fixproof.db"

# JWT Auth Secret
JWT_SECRET="fixproof_hackathon_demo_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gemini Vision API Key (Optional: leave empty to run in honest Basic Heuristic Mode)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Storage: "local" or "supabase"
STORAGE_BACKEND="local"
UPLOAD_DIR="./uploads"

# Optional Supabase integration for production
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_BUCKET="report-media"

# CORS Allowed Origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000"
